GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# SECURITY: Use a long, random string (min 64 chars). Never use simple words.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_JWT_SECRET

# SECURITY: Strong password for the admin account.
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# URL of the deployed frontend (used for CORS in production)
FRONTEND_URL=http://localhost:3000

# Set to "production" when deploying
NODE_ENV=development

# PostgreSQL / Supabase connection string
DATABASE_URL=YOUR_DATABASE_URL

# HTTPS local development configuration (set to true to test local HTTPS)
USE_HTTPS=false

# SSL certificate paths for Fastify HTTPS setup (if applicable in VPS or local testing)
# SSL_KEY_PATH=./certs/key.pem
# SSL_CERT_PATH=./certs/cert.pem
