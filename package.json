{
  "name": "emait-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend && node -e \"const fs=require('fs'); if(fs.existsSync('.next')) fs.rmSync('.next',{recursive:true,force:true}); fs.cpSync('frontend/.next','.next',{recursive:true});\"",
    "start": "npm run start --workspace=frontend",
    "dev": "node dev.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@google/generative-ai": "^0.21.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.8.5",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.3",
    "next": "15.5.15",
    "protobufjs": "^8.7.2",
    "zod": "^3.25.76"
  }
}
