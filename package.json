{
  "name": "emait-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend && node -e \"const fs=require('fs'); try{if(!fs.existsSync('.next'))fs.symlinkSync('frontend/.next','.next','junction')}catch(e){}\"",
    "start": "npm run start --workspace=frontend",
    "dev": "node dev.js"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "protobufjs": "^8.7.2"
  }
}
